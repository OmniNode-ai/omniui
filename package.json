{
  "name": "@omninode/omniui",
  "version": "0.0.0",
  "private": true,
  "description": "OmniNode web component library and renderer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmniNode-ai/omniui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "generate:onex-models": "tsx scripts/generate-onex-models.ts",
    "compile:tokens": "tsx scripts/compile-tokens.ts write",
    "check:tokens": "tsx scripts/compile-tokens.ts check"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "9.17.0",
    "jsdom": "25.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "storybook": "8.6.14",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
